async function searchDriveFiles(query, folderId) {
  try {
    const response = await fetch('https://genai.melioffice.com/proxy/anthropic/v1/messages', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: SYS,
        mcp_servers: [{type: 'url', url: 'https://drivemcp.googleapis.com/mcp/v1', name: 'google-drive'}],
        messages: [{role: 'user', content: `Busca en Google Drive en la carpeta con ID "${folderId}" archivos relacionados con: "${query}". Lista los 3 más relevantes con su ID y título. Responde solo con JSON: {"files": [{"id": "...", "title": "..."}]}`}]
      })
    });
    const data = await response.json();
    const txt = data.content?.map(b=>b.text||'').join('') || '';
    const clean = txt.replace(/```json|```/g,'').trim();
    return JSON.parse(clean);
  } catch(e) { return {files: []}; }
}

async function readDriveFile(fileId, fileName) {
  try {
    const response = await fetch('https://genai.melioffice.com/proxy/anthropic/v1/messages', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: SYS,
        mcp_servers: [{type: 'url', url: 'https://drivemcp.googleapis.com/mcp/v1', name: 'google-drive'}],
        messages: [{role: 'user', content: `Lee el contenido del archivo de Google Drive con ID "${fileId}" (${fileName}) y devuelve un resumen del contenido relevante en máximo 800 palabras.`}]
      })
    });
    const data = await response.json();
    return data.content?.map(b=>b.text||'').join('') || '';
  } catch(e) { return ''; }
}

async function searchDriveDoc(lado) {
  const query = document.getElementById(`cmp-search-${lado.toLowerCase()}`).value.trim();
  if (!query) return alert('Escribe un término de búsqueda');
  const results = await searchDriveFiles(query, DRIVE.expediente.folderId);
  if (results.files && results.files.length > 0) {
    const file = results.files[0];
    const content = await readDriveFile(file.id, file.title);
    if (lado === 'A') { dA = content; dAName = file.title; }
    else { dB = content; dBName = file.title; }
    document.getElementById(`d${lado}-n`).textContent = file.title + ' (Drive)';
    document.getElementById(`d${lado}-s`).textContent = 'Leído desde Google Drive';
    document.getElementById(`d${lado}-i`).classList.remove('hid');
  } else {
    alert('No se encontró el documento en Drive. Intenta con otro término o sube el archivo directamente.');
  }
}

