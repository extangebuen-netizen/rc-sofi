async function runReg() {
  const q = document.getElementById('reg-q').value.trim();
  if (!q) return alert('Ingresa una consulta.');
  setSt('reg-st', 'processing');
  document.getElementById('reg-res').classList.add('hid');

  // Buscar documentos relevantes en el dataset local
  const docsRelevantes = buscarEnDataset(q);
  const contexto = docsRelevantes.length 
    ? docsRelevantes.map(d => `=== ${d.titulo} ===\n${d.texto}`).join('\n\n')
    : DATASET_REGULACION.slice(0,3).map(d => `=== ${d.titulo} ===\n${d.texto}`).join('\n\n');

  const sys = `\n\nMÓDULO: /regulacion\nTienes acceso a los siguientes documentos regulatorios reales de Mercado Fondos SOFI. Responde la consulta citando el documento exacto, artículo y sección.\n\nFORMATO:\n1. **RESUMEN EJECUTIVO**\n2. **FUNDAMENTO REGULATORIO** (cita documento + artículo + sección)\n3. **TABLA DE CITAS** | Norma | Artículo | Sección | Fuente |\n4. **RIESGO**: Alto/Medio/Bajo\n5. **RECOMENDACIÓN**`;

  const msg = `Consulta regulatoria: "${q}"\n\nDocumentos relevantes encontrados:\n\n${contexto}`;

  try {
    const result = await apiWithDrive(msg, sys, '');
    const docNames = docsRelevantes.map(d => d.titulo);
    if (docNames.length) showSources('reg-sources', docNames);
    renderReg(result, q);
    setSt('reg-st', 'done');
  } catch(e) {
    console.error(e);
    alert('Error: ' + e.message);
    setSt('reg-st', 'idle');
  }
}

