const VERDI_WEBHOOK = 'https://workflows.melisystems.com/webhook/371bde64-bebd-441b-b579-eb900b1d3052';

async function apiWithDrive(userMsg, systemExtra, driveContext) {
  const fullQuestion = (systemExtra || '') + (driveContext ? '\n\n' + driveContext : '') + '\n\n' + userMsg;
  const response = await fetch(VERDI_WEBHOOK, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({question: fullQuestion})
  });
  const data = await response.json();
  if (Array.isArray(data)) {
    return data[0]?.output || data[0]?.text || data[0]?.response || data[0]?.message || JSON.stringify(data[0]);
  }
  return data?.output || data?.text || data?.response || data?.message || '';
}

