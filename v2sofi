function buscarEnDataset(query) {
  const q = query.toLowerCase();
  const keywords = q.split(/\s+/).filter(w => w.length > 3);
  return DATASET_REGULACION
    .map(doc => {
      const score = keywords.reduce((s, kw) => s + (doc.texto.toLowerCase().includes(kw) ? 1 : 0) + (doc.titulo.toLowerCase().includes(kw) ? 2 : 0), 0);
      return {...doc, score};
    })
    .filter(d => d.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 5);
}

