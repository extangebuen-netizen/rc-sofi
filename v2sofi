<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--y:#FFE600;--yd:#e6cf00;--b:#1a1f36;--b2:#2d3561;--g:#f5f6fa;--w:#fff;--border:#e4e6f0;--muted:#9298b0;--alto:#ef4444;--medio:#f59e0b;--bajo:#22c55e}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--g);color:var(--b);min-height:100vh}
.page{display:none}.page.on{display:block}
.topbar{position:sticky;top:0;z-index:99;background:var(--w);border-bottom:2px solid var(--border);height:60px;display:flex;align-items:center;padding:0 28px;gap:14px}
.back{background:var(--y);border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;color:var(--b)}
.tb-title{font-size:15px;font-weight:800;color:var(--b)}
.tb-sub{font-size:11px;color:var(--muted)}
.spill{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;margin-left:auto}
.s-idle{background:#f1f5f9;color:var(--muted)}
.s-proc{background:#eff6ff;color:#2563eb}
.s-done{background:#dcfce7;color:#15803d}
.mcontent{padding:28px 32px;max-width:1200px;margin:0 auto}
.card{background:var(--w);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:16px}
.ctitle{font-size:13px;font-weight:800;color:var(--b);margin-bottom:4px;display:flex;align-items:center;gap:8px}
.csub{font-size:11px;color:var(--muted);margin-bottom:14px}
.sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.scard{background:var(--w);border:2px solid var(--border);border-radius:14px;padding:16px;text-align:center}
.snum{font-size:26px;font-weight:800}.slbl{font-size:10px;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.05em}
textarea{width:100%;border:1.5px solid var(--border);border-radius:10px;padding:12px;font-size:13px;font-family:inherit;resize:vertical;min-height:110px;background:#fafbfd}
textarea:focus{outline:none;border-color:var(--b);background:var(--w)}
.rbox{background:#fafbfd;border:1.5px solid var(--border);border-radius:12px;padding:16px;font-size:13px;line-height:1.75}
.btn{padding:8px 16px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:none}
.bp{background:var(--b);color:#fff}.bp:hover{background:var(--b2)}
.by{background:var(--y);color:var(--b)}.by:hover{background:var(--yd)}
.bg{background:transparent;color:#4a5068;border:1.5px solid var(--border)}.bg:hover{background:var(--g)}
.row{display:flex;gap:8px;margin-top:10px;align-items:center}
.ml{margin-left:auto}.fx{display:flex}.g8{gap:8px}.ic{align-items:center}
.mt12{margin-top:12px}.hid{display:none!important}
.dz{border:2px dashed var(--border);border-radius:12px;padding:28px;text-align:center;cursor:pointer;background:#fafbfd}
.dz:hover{border-color:var(--b);background:#f0f3fc}
.dz-icon{font-size:28px;margin-bottom:8px}.dz-label{font-size:13px;color:#4a5068;font-weight:600}.dz-sub{font-size:11px;color:var(--muted);margin-top:4px}
.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.twrap{overflow-x:auto;margin-top:12px}
table{width:100%;border-collapse:collapse;font-size:12px}
th{background:var(--g);color:#4a5068;font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:.06em;padding:9px 10px;text-align:left;border-bottom:2px solid var(--border)}
td{padding:10px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.5}
tr:last-child td{border-bottom:none}
tr:hover td{background:#fafbfd}
.rb{display:inline-block;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700}
.r-alto,.r-alta{background:#fee2e2;color:#b91c1c}
.r-medio,.r-media{background:#fef3c7;color:#b45309}
.r-bajo,.r-baja{background:#dcfce7;color:#15803d}
.disc{background:#fffbe0;border:1.5px solid var(--y);border-radius:10px;padding:10px 14px;font-size:11px;color:#7a6200;display:flex;gap:8px;margin-bottom:18px}
.drive-badge{background:#e8f5e9;border:1px solid #a5d6a7;border-radius:8px;padding:8px 12px;font-size:11px;color:#2e7d32;display:flex;align-items:center;gap:8px;margin-bottom:14px}
.tabs{display:flex;gap:4px;background:#f0f2f8;padding:4px;border-radius:10px;margin-bottom:20px}
.tab{flex:1;padding:8px;border-radius:7px;border:none;cursor:pointer;font-size:12px;font-weight:700;color:var(--muted);background:transparent}
.tab.on{background:var(--w);color:var(--b);box-shadow:0 1px 4px rgba(0,0,0,.08)}
.emenu-wrap{position:relative}
.emenu{position:absolute;right:0;top:110%;background:var(--w);border:1.5px solid var(--border);border-radius:12px;box-shadow:0 8px 28px rgba(0,0,0,.1);z-index:200;min-width:210px;overflow:hidden}
.emenu-sec{padding:7px 14px 5px;font-size:9px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;background:#f8f9fc}
.emenu-item{padding:10px 16px;font-size:13px;cursor:pointer;display:flex;align-items:center;gap:10px}
.emenu-item:hover{background:var(--g)}
.src-file{background:#f0f7ff;border:1px solid #bfdbfe;border-radius:8px;padding:6px 10px;font-size:10px;color:#1e40af;margin-top:8px;display:flex;align-items:center;gap:6px}
</style>
