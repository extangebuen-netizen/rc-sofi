<body>

<!-- ═══ HOME ═══ -->
<div id="p-home" class="page on">
  <div style="min-height:100vh;background:var(--y);display:flex;flex-direction:column;align-items:center">
    <div style="width:100%;padding:24px;display:flex;justify-content:center;border-bottom:2px solid rgba(0,0,0,.07)">
      <div style="font-size:22px;font-weight:900;color:var(--b);letter-spacing:-.5px">Mercado Fondos</div>
    </div>
    <div style="margin-top:40px;background:var(--w);border-radius:20px;padding:28px 56px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.09)">
      <div style="font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:10px">Mercado Fondos S.A. de C.V. · SOFI México</div>
      <div style="font-size:32px;font-weight:900;color:var(--b);letter-spacing:-.5px;line-height:1.1">Centro de Gestión<br>Regulatoria</div>
      <div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px">
        <span style="display:inline-flex;align-items:center;gap:5px;background:#f0f2f8;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700;color:var(--b2)">🏛️ Risk &amp; Compliance</span>
        <span style="display:inline-flex;align-items:center;gap:5px;background:#e8f5e9;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700;color:#2e7d32">📁 Google Drive conectado</span>
      </div>
    </div>
    <div style="margin-top:28px;font-size:16px;font-weight:700;color:var(--b);opacity:.7">Selecciona el módulo de trabajo</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:760px;width:100%;padding:0 24px;margin-top:20px">
      <div onclick="go('regulacion')" style="background:var(--w);border-radius:20px;padding:26px 22px;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,.07);border:2px solid transparent;transition:.2s" onmouseover="this.style.borderColor='#1a1f36'" onmouseout="this.style.borderColor='transparent'">
        <div style="width:48px;height:48px;background:#fffbe0;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;border:1.5px solid var(--y)">⚖️</div>
        <div style="font-size:15px;font-weight:800;color:var(--b)">Consulta Regulatoria</div>
        <div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6">Analiza tu normativa real desde Drive: CNBV, PLD, Banxico, AMIB, CONDUSEF y Leyes.</div>
        <div style="display:inline-block;margin-top:16px;background:var(--y);color:var(--b);font-size:12px;font-weight:700;padding:7px 16px;border-radius:20px">Abrir módulo →</div>
      </div>
      <div onclick="go('oficio')" style="background:var(--w);border-radius:20px;padding:26px 22px;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,.07);border:2px solid transparent;transition:.2s" onmouseover="this.style.borderColor='#1a1f36'" onmouseout="this.style.borderColor='transparent'">
        <div style="width:48px;height:48px;background:#fffbe0;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;border:1.5px solid var(--y)">📋</div>
        <div style="font-size:15px;font-weight:800;color:var(--b)">Análisis de Oficio CNBV</div>
        <div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6">Cruza el oficio con tus Anexos reales del expediente SOFI para identificar documentos a modificar.</div>
        <div style="display:inline-block;margin-top:16px;background:var(--y);color:var(--b);font-size:12px;font-weight:700;padding:7px 16px;border-radius:20px">Abrir módulo →</div>
      </div>
      <div onclick="go('comparar')" style="background:var(--w);border-radius:20px;padding:26px 22px;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,.07);border:2px solid transparent;transition:.2s" onmouseover="this.style.borderColor='#1a1f36'" onmouseout="this.style.borderColor='transparent'">
        <div style="width:48px;height:48px;background:#fffbe0;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;border:1.5px solid var(--y)">📑</div>
        <div style="font-size:15px;font-weight:800;color:var(--b)">Comparación Documental</div>
        <div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6">Compara versiones de tus Anexos directamente desde Drive o carga archivos locales.</div>
        <div style="display:inline-block;margin-top:16px;background:var(--y);color:var(--b);font-size:12px;font-weight:700;padding:7px 16px;border-radius:20px">Abrir módulo →</div>
      </div>
      <div onclick="go('prediccion')" style="background:var(--w);border-radius:20px;padding:26px 22px;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,.07);border:2px solid transparent;transition:.2s" onmouseover="this.style.borderColor='#1a1f36'" onmouseout="this.style.borderColor='transparent'">
        <div style="width:48px;height:48px;background:#fffbe0;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;border:1.5px solid var(--y)">📡</div>
        <div style="font-size:15px;font-weight:800;color:var(--b)">Inteligencia Predictiva</div>
        <div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6">Predicción basada en tu expediente real y regulación vigente desde Drive.</div>
        <div style="display:inline-block;margin-top:16px;background:var(--y);color:var(--b);font-size:12px;font-weight:700;padding:7px 16px;border-radius:20px">Abrir módulo →</div>
      </div>
    </div>
    <div style="margin-top:28px;padding:16px;font-size:11px;color:rgba(26,31,54,.4);letter-spacing:.04em">MERCADO FONDOS S.A. DE C.V. SOFI · CONFIDENCIAL · USO INTERNO</div>
  </div>
</div>

<!-- ═══ MOD 1: REGULACIÓN ═══ -->
<div id="p-regulacion" class="page">
  <div class="topbar">
    <button class="back btn" onclick="go('home')">← Inicio</button>
    <span class="tb-title">⚖️ Consulta Regulatoria</span>
    <span class="tb-sub">· Drive conectado</span>
    <span class="spill s-idle" id="reg-st">● Listo</span>
  </div>
  <div class="mcontent">
    <div class="drive-badge">📁 <span>📦 Dataset embebido · <strong>10 documentos CNBV</strong> · Regulación real · Sin dependencia de Drive</span></div>
    <div class="disc">⚠️ <span>Las respuestas se basan en tus documentos reales de Drive. No constituyen asesoría legal definitiva.</span></div>
    <div class="tabs">
      <button class="tab on" id="rt-n" onclick="rtab('n')">✏️ Nueva consulta</button>
      <button class="tab" id="rt-h" onclick="rtab('h')">📂 Historial</button>
    </div>
    <div id="reg-n">
      <div class="card">
        <div class="ctitle">📝 Ingresa tu consulta regulatoria</div>
        <div class="csub">El sistema buscará en tus carpetas de Drive: CNBV, PLD, Banxico, AMIB, CONDUSEF y Leyes.</div>
        <textarea id="reg-q" placeholder="Ejemplo: ¿Qué requisitos debe cumplir el MAM de una SOFI según la CUFI?&#10;El sistema buscará en tus documentos reales de Drive antes de responder."></textarea>
        <div class="row"><div class="ml fx g8">
          <button class="btn bg" onclick="document.getElementById('reg-q').value='¿Qué requisitos establece la CUFI para el Manual de Administración de la Metodología (MAM) de una SOFI, específicamente sobre valuación de cartera?'">Ver ejemplo</button>
          <button class="btn bp" onclick="runReg()">▶ Buscar en Drive y analizar</button>
        </div></div>
      </div>
      <div id="reg-res" class="hid">
        <div class="sgrid">
          <div class="scard"><div class="snum" id="rr-n">—</div><div class="slbl">Normas</div></div>
          <div class="scard"><div class="snum" id="rr-a">—</div><div class="slbl">Artículos</div></div>
          <div class="scard"><div class="snum" id="rr-r">—</div><div class="slbl">Riesgo</div></div>
          <div class="scard"><div class="snum" id="rr-docs">—</div><div class="slbl">Docs leídos</div></div>
        </div>
        <div id="reg-sources" class="hid" style="margin-bottom:12px"></div>
        <div class="card"><div class="ctitle">📊 Resultado</div><div id="reg-box" class="rbox"></div></div>
      </div>
    </div>
    <div id="reg-h" class="hid">
      <div class="card"><div class="ctitle">📂 Historial</div><div id="reg-hlist"><div style="color:var(--muted);font-size:12px;padding:12px 0">Sin consultas aún.</div></div></div>
    </div>
  </div>
</div>

<!-- ═══ MOD 2: OFICIO ═══ -->
<div id="p-oficio" class="page">
  <div class="topbar">
    <button class="back btn" onclick="go('home')">← Inicio</button>
    <span class="tb-title">📋 Análisis de Oficio CNBV</span>
    <span class="tb-sub">· Drive conectado</span>
    <span class="spill s-idle" id="of-st">● Listo</span>
  </div>
  <div class="mcontent">
    <div class="drive-badge">📁 <span>Cruzando con Google Drive · Carpeta: <strong>Expediente SOFI</strong> (Anexos 1-14 · Contratos · Estatutos)</span></div>
    <div class="disc">⚠️ <span>Valida con el área jurídica antes de emitir respuesta oficial.</span></div>
    <div class="card">
      <div class="ctitle">📎 Cargar oficio CNBV</div>
      <div class="csub">PDF, DOCX o TXT · El sistema cruzará el oficio con tus Anexos reales del expediente en Drive</div>
      <div class="dz" onclick="document.getElementById('of-file').click()" id="of-dz">
        <div class="dz-icon">📄</div><div class="dz-label">Arrastra el oficio o haz clic</div><div class="dz-sub">PDF, DOCX, TXT</div>
        <input type="file" id="of-file" accept=".pdf,.docx,.doc,.txt" class="hid" onchange="hdlOf(this)"/>
      </div>
      <div id="of-finfo" class="hid mt12 fx ic g8" style="background:#fffbe0;padding:10px;border-radius:10px;border:1.5px solid var(--y)">
        <span style="font-size:20px">📋</span>
        <div><div style="font-size:13px;font-weight:700" id="of-fname"></div><div style="font-size:11px;color:var(--muted)" id="of-fsize"></div></div>
        <button class="btn bg ml" onclick="clrOf()">✕</button>
      </div>
      <div class="row mt12"><textarea id="of-ctx" placeholder="(Opcional) Contexto adicional: número de vuelta, observaciones ya atendidas..." style="min-height:56px"></textarea></div>
      <div class="row"><div class="ml fx g8">
        <button class="btn bg" onclick="demoOf()">👁 Ver demo</button>
        <button class="btn bp" onclick="runOf()">▶ Buscar en Drive y extraer</button>
      </div></div>
    </div>
    <div id="of-res" class="hid">
      <div class="sgrid">
        <div class="scard"><div class="snum" id="or-t" style="color:var(--b)">—</div><div class="slbl">Total obs.</div></div>
        <div class="scard"><div class="snum" id="or-a" style="color:var(--alto)">—</div><div class="slbl">Riesgo alto</div></div>
        <div class="scard"><div class="snum" id="or-m" style="color:var(--medio)">—</div><div class="slbl">Riesgo medio</div></div>
        <div class="scard"><div class="snum" id="or-b" style="color:var(--bajo)">—</div><div class="slbl">Riesgo bajo</div></div>
      </div>
      <div id="of-sources" class="hid" style="margin-bottom:12px"></div>
      <div class="card">
        <div class="ctitle fx ic g8">📋 Tabla de observaciones
          <div class="emenu-wrap ml">
            <button class="btn by" style="font-size:11px" onclick="toggleEM('of-em',event)">↓ Exportar ▾</button>
            <div id="of-em" class="emenu hid">
              <div class="emenu-sec">Tabla de observaciones</div>
              <div class="emenu-item" onclick="expOfCSV()"><span>📊</span><div><b>Google Sheets (CSV)</b></div></div>
              <div style="height:1px;background:var(--border)"></div>
              <div class="emenu-sec">Resumen ejecutivo</div>
              <div class="emenu-item" onclick="expOfPDF()"><span>📄</span><div><b>Descargar PDF</b></div></div>
            </div>
          </div>
        </div>
        <div class="twrap"><table>
          <thead><tr><th>#</th><th>Materia</th><th>Observación</th><th>Art.</th><th>Docs a modificar (Drive)</th><th>Tipo</th><th>Riesgo</th><th>Atención</th><th>Responsable</th><th>Plazo</th><th>Consecuencia</th></tr></thead>
          <tbody id="of-tb"></tbody>
        </table></div>
      </div>
      <div class="card mt12"><div class="ctitle">📊 Resumen ejecutivo</div><div id="of-sum" class="rbox"></div></div>
    </div>
  </div>
</div>

<!-- ═══ MOD 3: COMPARAR ═══ -->
<div id="p-comparar" class="page">
  <div class="topbar">
    <button class="back btn" onclick="go('home')">← Inicio</button>
    <span class="tb-title">📑 Comparación Documental</span>
    <span class="tb-sub">· Drive conectado</span>
    <span class="spill s-idle" id="cmp-st">● Listo</span>
  </div>
